# Entorno: LOCAL, NUBE o TESTING
APP_ENV=LOCAL

# Flask
SECRET_KEY=reemplazar-por-un-secreto-largo-y-aleatorio
MAX_CONTENT_LENGTH_MB=8
SESSION_VALIDATION_INTERVAL_SECONDS=60
# En producción usa Redis, por ejemplo: redis://usuario:clave@host:puerto/0
RATELIMIT_STORAGE_URI=memory://
# Actívalo solo si la aplicación está detrás de un proxy propio/confiable.
TRUST_PROXY=False

# MySQL del entorno activo. Usa valores locales en desarrollo y los de Aiven
# en el archivo de variables del despliegue.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=coffee_hacienda
DB_PASSWORD=reemplazar
DB_NAME=coffee_hacienda

# Solo en NUBE/PRODUCTION: ruta absoluta al certificado CA de Aiven.
DB_SSL_CA=C:/ruta/al/ca.pem

# Correo
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=correo@example.com
MAIL_PASSWORD=reemplazar
